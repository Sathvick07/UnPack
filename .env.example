# ========================================================
# Unpack — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ========================================================

# Django Backend Configuration
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-unpack-dev-secret-key-replace-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Vision / OCR Provider (Backend only, never expose to frontend)
GEMINI_API_KEY=your-gemini-vision-api-key-here

# Frontend Configuration (Public Vite environment variable)
VITE_API_BASE_URL=http://localhost:8000
